# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET / AUTH_SECRET: HMAC secret used by CardClash web & server to sign and verify player session tokens.
SESSION_SECRET="cardclash-dev-secret-change-in-production-32bytes"
AUTH_SECRET="cardclash-dev-secret-change-in-production-32bytes"

# REDIS_URL: Optional Redis connection string for room snapshots, room-code lookup, and presence.
# If unset or empty, CardClash automatically falls back to the in-memory store.
REDIS_URL=""

# DATABASE_URL: Optional PostgreSQL connection string for Drizzle ORM accounts, match history, and OpenSkill ratings.
# If unset or empty, CardClash automatically falls back to InMemoryAccountRepository.
DATABASE_URL=""

# SERVER_PORT: Optional standalone Socket.IO server port (defaults to 3001 when standalone, or attaches to 3000 in unified mode).
SERVER_PORT="3001"
